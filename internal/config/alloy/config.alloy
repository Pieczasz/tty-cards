logging {
  level  = "info"
  format = "logfmt"
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    logs    = [otelcol.exporter.loki.default.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

// Reads Alloy's own /proc and /sys. On a Linux server (shared kernel) this
// reports real host CPU/memory/network/load; filesystem metrics are the
// container's view. Bind-mount the host and set *fs_path for full host disk.
prometheus.exporter.unix "host" {
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// Container stdout/stderr into Loki. Without this, everything that bypasses the
// OTLP log path - panic dumps, the Postgres and nginx logs, anything a library
// writes straight to stderr - exists only in `docker logs`.
//
// Through docker-socket-proxy, never the socket itself: read access to
// /var/run/docker.sock is root on the host (it can start a privileged container),
// and this needs only to list containers and networks and read their logs.
discovery.docker "containers" {
  host = "tcp://docker-socket-proxy:2375"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  // Alloy and Loki are dropped: shipping Loki's own "received push" lines back
  // into Loki makes every push generate the next one.
  rule {
    source_labels = ["compose_service"]
    regex         = "alloy|loki"
    action        = "drop"
  }
}

loki.source.docker "containers" {
  host       = "tcp://docker-socket-proxy:2375"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.containers.receiver]
  labels     = { source = "docker" }
}

loki.process "containers" {
  forward_to = [loki.write.default.receiver]

  // installLogging fans every slog record to stderr *and* the OTLP bridge, and the
  // stderr copy is what Docker captures - so without this every backend log line is
  // stored twice under two label sets, doubling retention and every LogQL rate over
  // the backend. The OTLP copy is the one worth keeping (it carries the trace IDs),
  // so the docker copy of a structured record goes.
  //
  // Only records the logger wrote match: a panic dump, a Go runtime crash and
  // anything a library prints straight to stderr are not JSON, and those are the
  // reason this scrape exists at all.
  stage.drop {
    expression          = "^\\{\"time\":\".*\",\"level\":"
    drop_counter_reason = "duplicate_of_otlp_log"
  }

  // nginx's error log names the client on every line ("client: 203.0.113.7,
  // server: ..."). The rest of the line - which upstream failed, and how - is what
  // an operator needs from it, so only the address goes. The rate-limit rejections,
  // the one high-volume source of such lines, are kept below nginx's log threshold
  // in nginx.conf; this is for the errors that remain.
  stage.match {
    selector = "{compose_service=\"proxy\"}"

    stage.replace {
      expression = "client: ([^,\\s]+)"
      replace    = "redacted"
    }
  }
}
