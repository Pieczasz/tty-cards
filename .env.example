# Server Configuration
# For docker compose on a VPS: copy to .env and set a strong unique DB_PASSWORD.
# Compose sets ENV=production on the backend; do not publish SERVER_PORT (6969) on the host -
# only nginx should reach it (PROXY protocol). See README "Self-hosting" and docs/SECURITY.md.
# ENV (production, staging or development; unset means development) is read only
# from the process environment, before this file: an ENV line here fails the boot.
# Export it, e.g. `ENV=staging ./bin/server`.
SERVER_HOST=0.0.0.0
SERVER_PORT=6969
MAX_CONNECTIONS=1000
SSH_KEY_PATH=.wishlist/server
SERVICE_VERSION=0.1.0

# Rate limiting (SSH auth attempts per client network; IPv6 is grouped by /64,
# and each IPv6 /48 also gets 16 times this. An ssh-agent offers every key it
# holds, and each offer counts one attempt.)
RATE_LIMIT_CONNECTIONS=5
RATE_LIMIT_WINDOW=1s
# New accounts per window (Go duration): per client network (IPv6 /64), per IPv6
# /48 (a free tunnel is one /48; IPv4 stays per address) and server-wide. Raise all
# three for make loadtest, which registers one account per session.
# REGISTRATION_LIMIT=5
# REGISTRATION_LIMIT_WIDE=20
# REGISTRATION_GLOBAL_LIMIT=600
# REGISTRATION_WINDOW=1h

# Log level for both stderr and OTLP sinks: DEBUG, INFO (default), WARN, ERROR
# LOG_LEVEL=INFO

# PROXY protocol on the SSH listener. Leave the default (true) behind nginx;
# set false only for local development against a bare ssh client.
# PROXY_PROTOCOL=false
# Comma-separated networks allowed to send the PROXY header (the nginx container's
# subnet). Connections from anywhere else are refused. Empty trusts any peer in
# development only; with PROXY_PROTOCOL or API_TRUST_PROXY on, any other ENV
# refuses to boot (docs/decisions.md #9).
# PROXY_TRUSTED_CIDRS=

# API_PORT=6970
# API_ALLOW_ORIGIN=*
# API_REQUESTS_PER_MINUTE=120
# API_TRUST_PROXY=true
# Note: API_TRUST_PROXY should only be enabled when a trusted reverse proxy sets
# X-Forwarded-For and the backend is not directly reachable by clients.

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=terminal_card
DB_PASSWORD=your_local_database_password
# development default: disable | everywhere else: require
# outside ENV=development only require, verify-ca or verify-full boot
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25

# OpenTelemetry (optional)
# a URL: http:// exports in plaintext, https:// over TLS
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Read by compose, not the server: the apex the TLS certificate is issued for, and
# the optional contact on the Let's Encrypt account.
# TTY_DOMAIN=tty.cards
# ACME_EMAIL=
# Where Alertmanager's Telegram bot token and chat id live on the host (docs/SECURITY.md,
# "Alert delivery"). Keep it outside the checkout.
# ALERTMANAGER_SECRETS_DIR=/etc/tty-cards/alertmanager

# Grafana has no password: it is published on 127.0.0.1:3000 only, so reaching it
# means an SSH session on the host. Open it with `ssh -L 3000:127.0.0.1:3000 <host>`
# and browse http://localhost:3000.

# For make migrate-up / migrate-down (separate from the server's DB_* vars)
# DB_DSN=postgres://postgres:your_local_database_password@localhost:5432/terminal_card?sslmode=disable
